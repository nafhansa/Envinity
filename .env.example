# Envinity configuration. Copy to .env, or run `npm run setup` to generate one with fresh secrets.

NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
# Origin of the web app (Astro dev server). Used for CORS.
APP_URL=http://localhost:4321

# Runtime connection: least-privilege role, so Row Level Security applies.
DATABASE_URL=postgres://envinity_app:envinity_app_dev_password@127.0.0.1:5434/envinity
# Migrations only (superuser, DDL).
MIGRATE_DATABASE_URL=postgres://envinity:envinity_dev_password@127.0.0.1:5434/envinity

# Secrets: at least 32 characters each. Never reuse between environments.
JWT_SECRET=
# 32 random bytes, base64. Encrypts TOTP (2FA) secrets at rest.
TOTP_ENCRYPTION_KEY=
# HMAC pepper for share-code lookups and recovery codes.
LOOKUP_PEPPER=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
MFA_CHALLENGE_TTL_SEC=300
FREE_TICKET_TTL_SEC=600

COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
# Billing is not connected yet. Lets the dashboard switch Free/Pro in development.
ALLOW_PLAN_SELF_SERVE=true
